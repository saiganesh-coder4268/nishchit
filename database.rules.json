{
  "rules": {
    "buses": {
      "$busId": {
        ".read": "auth != null && (data.child('driverId').val() == auth.uid || root.child('users').child(auth.uid).child('busId').val() == $busId || root.child('users').child(auth.uid).child('role').val() == 'admin')",
        ".write": "auth != null && (data.child('driverId').val() == auth.uid || root.child('users').child(auth.uid).child('role').val() == 'admin')",
        "status": {
          ".validate": "newData.isString() && (newData.val() == 'NOT_STARTED' || newData.val() == 'STARTING' || newData.val() == 'LIVE' || newData.val() == 'ENDING' || newData.val() == 'COMPLETED')"
        },
        "latitude": {
          ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90"
        },
        "longitude": {
          ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180"
        }
      }
    },
    "institutions": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() == 'admin'"
    },
    "routes": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() == 'admin'"
    },
    "driverApplications": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() == 'admin'",
      "$appId": {
        ".write": "auth != null && (auth.uid == $appId || root.child('users').child(auth.uid).child('role').val() == 'admin')"
      }
    },
    "students": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() == 'admin'",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() == 'admin'"
    },
    "users": {
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || root.child('users').child(auth.uid).child('role').val() == 'admin')",
        ".write": "auth != null && (auth.uid == $uid || root.child('users').child(auth.uid).child('role').val() == 'admin')"
      }
    },
    "messages": {
      "$busId": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('busId').val() == $busId || root.child('users').child(auth.uid).child('role').val() == 'admin')",
        "$messageId": {
          ".write": "auth != null && (root.child('users').child(auth.uid).child('busId').val() == $busId || root.child('users').child(auth.uid).child('role').val() == 'admin')",
          "message": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 500"
          }
        }
      }
    },
    "reports": {
      ".read": "auth != null",
      "$reportId": {
        ".write": "auth != null"
      }
    },
    "trips": {
      ".read": "auth != null",
      "$routeId": {
        ".write": "auth != null && root.child('routes').child($routeId).child('driverUid').val() == auth.uid"
      }
    }
  }
}
