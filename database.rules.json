{
  "rules": {
    "buses": {
      ".read": true,
      "$busId": {
        ".write": "auth != null || auth.uid == 'demo-driver-001' || auth.uid == 'demo-admin-001'",
        "status": {
          ".validate": "newData.isString() && (newData.val() == 'NOT_STARTED' || newData.val() == 'STARTING' || newData.val() == 'LIVE' || newData.val() == 'ENDING' || newData.val() == 'COMPLETED')"
        },
        "latitude": {
          ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90"
        },
        "longitude": {
          ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180"
        }
      }
    },
    "institutions": {
      ".read": true,
      ".write": "auth != null"
    },
    "routes": {
      ".read": true,
      ".write": "auth != null"
    },
    "driverApplications": {
      ".read": "auth != null",
      "$appId": {
        ".write": "auth != null"
      }
    },
    "students": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "messages": {
      "$busId": {
        ".read": true,
        "$messageId": {
          ".write": "auth != null || auth == null",
          "message": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 500"
          }
        }
      }
    },
    "reports": {
      ".read": "auth != null",
      "$reportId": {
        ".write": "auth != null || auth == null"
      }
    }
  }
}
