{
  "rules": {
    "liveLocations": {
      "$tripId": {
        ".read": "auth != null",
        ".write": "auth != null",
        "latitude": {
          ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90"
        },
        "longitude": {
          ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180"
        }
      }
    },
    "busLocations": {
      "$busId": {
        ".read": "auth != null",
        ".write": "auth != null",
        "latitude": {
          ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90"
        },
        "longitude": {
          ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180"
        }
      }
    },
    "messages": {
      "$busId": {
        ".read": "auth != null",
        "$messageId": {
          ".write": "auth != null",
          "message": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 500"
          }
        }
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "buses": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "routes": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "trips": {
      ".read": "auth != null",
      ".write": "auth != null"
    }
  }
}
